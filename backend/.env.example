# AutoAI Backend — copy to .env and fill in values
# Never commit real secrets.
#
# =============================================================================
# RAILWAY (MANUAL — git push se ye fix NAHI hota!)
# =============================================================================
# 1) Railway project mein PostgreSQL service add karo (Database → Add PostgreSQL)
# 2) Auto_AI web service → Variables → DELETE karo agar DATABASE_URL mein
#    127.0.0.1 ya localhost ho
# 3) New Variable → "Add Reference" → Postgres → DATABASE_URL select karo
# 4) Redeploy karo, phir Console mein (vehicles already seeded ho to sirf knowledge):
#    alembic upgrade head
#    python -m app.scripts.seed_vehicles
#    python -m app.scripts.ingest_knowledge
#    (Redeploy ke baad startup auto-ingest bhi karta hai agar chunks empty hon)
# 5) Test: https://YOUR-API.up.railway.app/health/ready → database: "up"
# =============================================================================
#
# Production: set these in the Render/Railway dashboard (no .env file in the image).
# Full checklist: docs/DEPLOYMENT.md

# --- Plain config ---
APP_NAME=AutoAI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Comma-separated frontend origins allowed by CORS (env-driven; no code change needed)
# Local: http://localhost:3000
# Production: your Vercel production URL (code also allows https://*.vercel.app)
# Example production value:
# CORS_ORIGINS=https://auto-ai-kappa.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (sync — SQLAlchemy / Alembic / seed / ingest scripts)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Managed hosts may give postgres://… — the app normalizes to postgresql+psycopg2://
# Production often needs ?sslmode=require
# Local default: project Postgres on port 5433 (see README)
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/autoai

# PostgreSQL (async — reserved; optional in production)
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres@127.0.0.1:5433/autoai

# AI provider: openai | openrouter
# Railway: set AI_PROVIDER=openrouter when using OPENROUTER_API_KEY
AI_PROVIDER=openrouter
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RAG embeddings (Phase 6)
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.28

# Reliability / privacy / ops
RATE_LIMIT_PER_MINUTE=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.6
LLM_TIMEOUT_SECONDS=45
CONVERSATION_RETENTION_DAYS=30

# --- Secrets (API keys — never commit real values) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
