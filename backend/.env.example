# AutoAI Backend — copy to .env and fill in values
# Never commit real secrets.

APP_NAME=AutoAI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (sync — used by SQLAlchemy / Alembic)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Phase 2 local default: project-local Postgres on port 5433 (see README)
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/autoai

# PostgreSQL (async — reserved for async sessions in later phases)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres@127.0.0.1:5433/autoai

# AI provider abstraction (PLANNING.md Section B.4)
# Supported: openai, openrouter
AI_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RAG embeddings (Phase 6)
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.28

# Phase 8 — reliability / privacy
RATE_LIMIT_PER_MINUTE=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.6
LLM_TIMEOUT_SECONDS=45
CONVERSATION_RETENTION_DAYS=30
