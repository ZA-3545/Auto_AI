# AutoAI Frontend — copy to .env.local and fill in values
# Never commit real secrets.
#
# Plain config only (baked into the Next.js client bundle at build time).
# Local: http://localhost:8000
# Vercel: set NEXT_PUBLIC_API_URL in the project Environment Variables to your
# public backend HTTPS URL (no trailing slash), then redeploy.

NEXT_PUBLIC_API_URL=http://localhost:8000
