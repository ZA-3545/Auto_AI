# AutoAI Frontend — copy to .env.local and fill in values
# Never commit real secrets.
#
# Plain config only (baked into the Next.js client bundle at build time).
# Local: http://localhost:8000
# Vercel: set NEXT_PUBLIC_API_URL in Project → Settings → Environment Variables
# to your Railway HTTPS URL (no trailing slash), then Redeploy.
# Example production value:
# NEXT_PUBLIC_API_URL=https://autoai-production-e6a4.up.railway.app

NEXT_PUBLIC_API_URL=http://localhost:8000
